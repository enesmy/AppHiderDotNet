<Window x:Class="AppHiderNet.CensorOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CensorOverlayWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResize"
        ShowActivated="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <!-- Context Menu for removing the censor -->
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Set Image..." Click="SetImage_Click"/>
                <MenuItem Header="Use Default Censor" Click="UseDefault_Click"/>
                <Separator/>
                <MenuItem Header="Remove Censor" Click="RemoveCensor_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Custom Image Layer -->
        <Image x:Name="CustomImage" Visibility="Collapsed" Stretch="Fill"/>

        <!-- Default Visuals Layer -->
        <Grid x:Name="DefaultVisuals">
            <!-- Completely opaque white layer with maximum blur -->
            <Rectangle Fill="#FFFFFFFF">
                <Rectangle.Effect>
                    <BlurEffect Radius="100"/>
                </Rectangle.Effect>
            </Rectangle>
            
            <!-- Very dark overlay for complete privacy -->
            <Rectangle Fill="#E0000000"/>
            
            <!-- Another blur layer for extra privacy -->
            <Rectangle Fill="#C0808080">
                <Rectangle.Effect>
                    <BlurEffect Radius="80"/>
                </Rectangle.Effect>
            </Rectangle>
            
            <!-- Text overlay -->
            <TextBlock Text="🔒 CENSORED" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Opacity="1.0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="1.0"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
